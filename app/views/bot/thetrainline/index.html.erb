<div class="train-search-container">
  <h1><i class="fas fa-train"></i> Find Trains</h1>
  
  <%= form_with url: bot_thetrainline_search_path, method: :get, local: true, data: { controller: "station-validation" } do |form| %>
    <div class="form-group">
      <%= form.label :from, class: "form-label" do %>
        <i class="fas fa-map-pin"></i> From
      <% end %>
      <%= form.text_field :from, 
          placeholder: "Madrid, Barcelona...", 
          required: true,
          minlength: 2,
          maxlength: 100,
          value: params[:from],
          data: { station_validation_target: "from" },
          class: "form-input" %>
      <small class="form-help">Fixture Data: Madrid, Barcelona, Valencia, Sevilla</small>
    </div>

    <div class="form-group">
      <%= form.label :to, class: "form-label" do %>
        <i class="fas fa-map-pin" style="color: var(--primary);"></i> To
      <% end %>
      <%= form.text_field :to, 
          placeholder: "Valencia, Sevilla...", 
          required: true,
          minlength: 2,
          maxlength: 100,
          value: params[:to],
          data: { station_validation_target: "to" },
          class: "form-input" %>
      <small class="form-help">Fixture Data: Madrid, Barcelona, Valencia, Sevilla</small>
    </div>

    <div class="form-group">
      <%= form.label :departure_at, class: "form-label" do %>
        <i class="fas fa-calendar-alt"></i> When
      <% end %>
      <%= form.datetime_local_field :departure_at, 
          required: true,
          min: "2026-02-16T00:00",
          max: "2027-02-22T23:59",
          value: params[:departure_at] || "2026-02-16T09:00",
          data: { controller: "datetime" },
          class: "form-input" %>
      <small class="form-help">Fixture data: Feb 16-22, 2026</small>
    </div>

    <%= form.submit "Search Trains", class: "btn-primary" %>
  <% end %>

  <% if flash[:error] %>
    <div class="alert alert-error">
      <i class="fas fa-exclamation-circle"></i> <%= flash[:error] %>
    </div>
  <% end %>
</div>
